{
  "name": "@le-space/passkey-wallet",
  "version": "0.1.1",
  "description": "A passkey as the admin key of a Uniswap Calibur account (EIP-7702, ERC-4337 EntryPoint v0.8), signed with the WebAuthn DID provider's P-256 primitives, and session keys for Zama user decryption.",
