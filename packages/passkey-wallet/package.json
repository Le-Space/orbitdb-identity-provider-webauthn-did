  "main": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src/",
    "types/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "passkey",
    "webauthn",
    "p256",
    "calibur",
    "eip-7702",
    "erc-4337",
    "account-abstraction",
    "viem",
    "zama",
    "fhevm"
  ],
  "author": "OrbitDB Community",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Le-Space/orbitdb-identity-provider-webauthn-did.git",
    "directory": "packages/passkey-wallet"
  },
  "bugs": {
    "url": "https://github.com/Le-Space/orbitdb-identity-provider-webauthn-did/issues"
  },
  "homepage": "https://github.com/Le-Space/orbitdb-identity-provider-webauthn-did/tree/main/packages/passkey-wallet#readme",
  "peerDependencies": {
    "viem": "^2.56.5",
    "@le-space/orbitdb-identity-provider-webauthn-did": ">=0.8.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
